# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (injected by platform)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Session and Security Configuration
SESSION_SECRET="recircuit-dev-session-secret-change-in-production"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# Optional External Integrations (Safe fallbacks used when unconfigured)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@recircuit.org"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET="recircuit-uploads"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
